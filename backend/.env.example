# Puerto del servidor
PORT=3000

# Ruta del archivo SQLite
DATABASE_PATH=./data/bencinapp.db

# Fuente de precios: auto | cne | bencinaenlinea | snapshot
#  auto: usa la API oficial de la CNE si hay credenciales; si no, la API pública de bencinaenlinea.cl;
#        si ambas fallan y la base está vacía, carga el snapshot semilla incluido en data/seed.
PRICE_PROVIDER=auto

# Credenciales de https://api.cne.cl (registro gratuito)
CNE_EMAIL=
CNE_PASSWORD=

# Cada cuántos minutos sincronizar precios (0 = desactivado)
SYNC_INTERVAL_MINUTES=60

# Token para el panel de administración (usa uno largo y aleatorio)
ADMIN_TOKEN=cambia-esto-por-un-token-largo

# Orígenes permitidos para CORS en desarrollo (separados por coma)
CORS_ORIGINS=http://localhost:5173
